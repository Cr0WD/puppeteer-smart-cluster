{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
	"allowJs": false,
	"composite": false,
	"declaration": true,
	"declarationMap": true,
	"esModuleInterop": true,
	"forceConsistentCasingInFileNames": true,
	"inlineSources": false,
	"isolatedModules": true,
	"lib": [
	  "dom",
	  "dom.iterable",
	  "esnext"
	],
	"module": "ESNext",
	"moduleResolution": "Bundler",
	"noUnusedLocals": true,
	"noUnusedParameters": true,
	"preserveWatchOutput": true,
	"skipLibCheck": true,
	"strict": true,
	"rootDir": "src",
	"target": "ES2022"
  },
  "display": "Default",
  "exclude": [
	"dist",
	"build",
	"node_modules"
  ],
  "include": ["src/**/*.ts"]
}
