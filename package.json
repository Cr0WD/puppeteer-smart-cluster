{
	"version": "1.0.0",
	"license": "MIT",
	"name": "puppeteer-smart-cluster",
	"author": {
		"email": "freshcrowd@gmail.com",
		"name": "Denis Orlov",
		"url": "https://github.com/Cr0WD"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Cr0WD/puppeteer-smart-cluster"
	},
	"keywords": [
		"puppeteer",
		"chrome",
		"headless",
		"automation",
		"puppeteer-cluster"
	],
	"module": "dist/puppeteer-smart-cluster.esm.js",
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"start": "tsdx watch",
		"build": "tsdx build",
		"lint": "oxlint -c .oxlintrc.json .",
		"prepare": "install-peers && tsdx build",
		"postinstall": "manypkg fix && manypkg check",
		"lint:fix": "oxlint -c .oxlintrc.json --fix .",
		"format": "oxfmt .",
		"format:check": "oxfmt . --check"
	},
	"husky": {
		"hooks": {
			"pre-commit": "yarn lint"
		}
	},
	"publishConfig": {
		"access": "public",
		"branches": [
			"main"
		]
	},
	"peerDependencies": {
		"puppeteer": "^24.42.0"
	},
	"devDependencies": {
		"@manypkg/cli": "0.25.1",
		"bunchee": "^6.10.0",
		"eslint": "9.39.4",
		"eslint-import-resolver-typescript": "4.4.4",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-security": "4.0.0",
		"install-peers-cli": "^2.2.0",
		"oxfmt": "0.52.0",
		"oxlint": "1.67.0",
		"puppeteer": "^24.42.0",
		"tsdx": "^2.0.0",
		"typescript": "6.0.3"
	}
}
