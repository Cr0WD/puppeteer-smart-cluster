{
	"version": "1.1.0",
	"license": "MIT",
	"name": "puppeteer-smart-cluster",
	"author": {
		"email": "freshcrowd@gmail.com",
		"name": "Denis Orlov",
		"url": "https://github.com/Cr0WD"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cr0WD/puppeteer-smart-cluster.git"
	},
	"keywords": [
		"puppeteer",
		"chrome",
		"headless",
		"automation",
		"puppeteer-cluster"
	],
	"module": "dist/index.mjs",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"start": "tsdx watch",
		"build": "tsdx build && tsc --emitDeclarationOnly --outDir dist && node scripts/prepare-dist.cjs",
		"test": "yarn build && node --test test/index.test.cjs",
		"typecheck": "tsc --noEmit",
		"validate": "yarn lint && yarn format:check && yarn typecheck && yarn test",
		"lint": "oxlint -c .oxlintrc.json .",
		"prepublishOnly": "yarn validate",
		"lint:fix": "oxlint -c .oxlintrc.json --fix .",
		"format": "oxfmt .",
		"format:check": "oxfmt . --check"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"puppeteer": "^25.7.0"
	},
	"devDependencies": {
		"bunchee": "^7.0.1",
		"eslint": "10.8.1",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-security": "4.0.1",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"puppeteer": "^25.7.0",
		"tsdx": "^2.0.0",
		"typescript": "7.0.2"
	}
}
